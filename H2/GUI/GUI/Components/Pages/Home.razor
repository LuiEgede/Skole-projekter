@page "/"
@rendermode InteractiveServer
@using GUI.Models
@using GUI.Repositories
@inject DatabaseRepository DatabaseRepository

<PageTitle>Home</PageTitle>

<div class="top-toolbar">
    <div>
        <strong>@TitleText</strong>
    </div>

    <div>
        <label for="languageSelect">Language:</label>
        <select id="languageSelect" @onchange="OnLanguageChanged">
            <option value="da" selected="@(selectedLanguage == "da")">Dansk</option>
            <option value="en" selected="@(selectedLanguage == "en")">English</option>
        </select>
    </div>
</div>

<div class="content-area">
    @if (tables == null)
    {
        <p>@LoadingText</p>
    }
    else if (!tables.Any())
    {
        <p>@NoTablesText</p>
    }
    else
    {
        <div class="table-select-section">
            <label for="tableSelect">@SelectTableText</label>
            <select id="tableSelect" @onchange="OnTableChanged">
                <option value="">-- @ChooseTableText --</option>
                @foreach (var table in tables)
                {
                    <option value="@table.TableName" selected="@(table.TableName == selectedTable)">
                        @table.TableName
                    </option>
                }
            </select>
        </div>

        @if (!string.IsNullOrWhiteSpace(selectedTable))
        {
            <div class="data-section">
                <h3>@selectedTable</h3>

                @if (tableData == null)
                {
                    <p>@LoadingTableDataText</p>
                }
                else if (!tableData.Any())
                {
                    <p>@NoRowsFoundText</p>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                @foreach (var column in tableData.First().Values.Keys)
                                {
                                    <th>@column</th>
                                }
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in tableData)
                            {
                                <tr style="cursor:pointer;" @onclick="() => SelectRow(row)">
                                    @foreach (var cell in row.Values.Values)
                                    {
                                        <td>@cell</td>
                                    }
                                    <td>
                                        <button @onclick:stopPropagation="true" @onclick="() => SelectRow(row)">Edit</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (selectedRow != null)
                    {
                        <div class="form-section">
                            <h4>@EditRowText</h4>

                            <div class="form-grid">
                                @foreach (var field in GetTableFields(selectedTable))
                                {
                                    <label>@field:</label>

                                    @if (IsReadOnlyKeyField(field))
                                    {
                                        <input value="@GetValue(selectedRow, field)" disabled />
                                    }
                                    else if (field == "StartDate" || field == "EndDate")
                                    {
                                        <input type="date"
                                               value="@GetValue(selectedRow, field)"
                                               @onchange="e => editValues[field] = e.Value?.ToString() ?? string.Empty" />
                                    }
                                    else if (field is "ManufactureYear" or "Quantity" or "CustomerId" or "CarId" or "WorkOrderId" or "PartId")
                                    {
                                        <input type="number"
                                               value="@GetValue(selectedRow, field)"
                                               @onchange="e => editValues[field] = e.Value?.ToString() ?? string.Empty" />
                                    }
                                    else if (field == "Price")
                                    {
                                        <input type="number" step="0.01"
                                               value="@GetValue(selectedRow, field)"
                                               @onchange="e => editValues[field] = e.Value?.ToString() ?? string.Empty" />
                                    }
                                    else
                                    {
                                        <input value="@GetValue(selectedRow, field)"
                                               @onchange="e => editValues[field] = e.Value?.ToString() ?? string.Empty" />
                                    }
                                }
                            </div>

                            <div class="form-actions">
                                <button @onclick="UpdateRow">@UpdateText</button>
                                <button class="danger-button" @onclick="DeleteRow">@DeleteText</button>
                            </div>
                        </div>
                    }

                    <div class="form-section">
                        <h4>@AddRowText</h4>

                        <div class="form-grid">
                            @foreach (var field in GetTableFields(selectedTable))
                            {
                                <label>@field:</label>

                                @if (field == "StartDate" || field == "EndDate")
                                {
                                    <input type="date"
                                           value="@GetValue(newValues, field)"
                                           @onchange="e => newValues[field] = e.Value?.ToString() ?? string.Empty" />
                                }
                                else if (field is "ManufactureYear" or "Quantity" or "CustomerId" or "CarId" or "WorkOrderId" or "PartId")
                                {
                                    <input type="number"
                                           value="@GetValue(newValues, field)"
                                           @onchange="e => newValues[field] = e.Value?.ToString() ?? string.Empty" />
                                }
                                else if (field == "Price")
                                {
                                    <input type="number" step="0.01"
                                           value="@GetValue(newValues, field)"
                                           @onchange="e => newValues[field] = e.Value?.ToString() ?? string.Empty" />
                                }
                                else
                                {
                                    <input value="@GetValue(newValues, field)"
                                           @onchange="e => newValues[field] = e.Value?.ToString() ?? string.Empty" />
                                }
                            }
                        </div>

                        <div class="form-actions">
                            <button @onclick="AddRow">@AddText</button>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private IEnumerable<TableInfo>? tables;
    private IEnumerable<TableRow>? tableData;
    private string selectedTable = string.Empty;
    private string selectedLanguage = "da";

    private TableRow? selectedRow;

    private Dictionary<string, string> newValues = new();
    private Dictionary<string, string> editValues = new();

    protected override void OnInitialized()
    {
        tables = DatabaseRepository.GetTables();
    }

    private void OnTableChanged(ChangeEventArgs e)
    {
        selectedTable = e.Value?.ToString() ?? string.Empty;
        tableData = string.IsNullOrWhiteSpace(selectedTable)
            ? Enumerable.Empty<TableRow>()
            : DatabaseRepository.GetTableData(selectedTable);

        selectedRow = null;
        newValues = CreateValueDictionary(selectedTable);
        editValues = CreateValueDictionary(selectedTable);
    }

    private void OnLanguageChanged(ChangeEventArgs e)
    {
        selectedLanguage = e.Value?.ToString() ?? "da";
    }

    private void SelectRow(TableRow row)
    {
        selectedRow = row;
        editValues = CreateValueDictionary(selectedTable);

        foreach (var field in GetTableFields(selectedTable))
        {
            editValues[field] = GetValue(row, field);
        }
    }

    private void AddRow()
    {
        if (string.IsNullOrWhiteSpace(selectedTable))
            return;

        var row = BuildRowFromValues(newValues);
        DatabaseRepository.InsertRow(selectedTable, row);

        tableData = DatabaseRepository.GetTableData(selectedTable);
        newValues = CreateValueDictionary(selectedTable);
    }

    private void UpdateRow()
    {
        if (selectedRow == null || string.IsNullOrWhiteSpace(selectedTable))
            return;

        var row = BuildRowFromValues(editValues);

        if (selectedTable == "workorderparts")
        {
            row.Values["WorkOrderId"] = GetValue(selectedRow, "WorkOrderId");
            row.Values["PartId"] = GetValue(selectedRow, "PartId");
        }
        else
        {
            var keyField = GetKeyField(selectedTable);
            row.Values[keyField] = GetValue(selectedRow, keyField);
        }

        DatabaseRepository.UpdateRow(selectedTable, row);
        tableData = DatabaseRepository.GetTableData(selectedTable);
    }

    private void DeleteRow()
    {
        if (selectedRow == null || string.IsNullOrWhiteSpace(selectedTable))
            return;

        var keyValues = new Dictionary<string, object?>();

        foreach (var key in GetKeyFields(selectedTable))
        {
            keyValues[key] = GetValue(selectedRow, key);
        }

        DatabaseRepository.DeleteRow(selectedTable, keyValues);

        tableData = DatabaseRepository.GetTableData(selectedTable);
        selectedRow = null;
        editValues = CreateValueDictionary(selectedTable);
    }

    private TableRow BuildRowFromValues(Dictionary<string, string> values)
    {
        var row = new TableRow();

        foreach (var field in GetTableFields(selectedTable))
        {
            row.Values[field] = values.TryGetValue(field, out var value) ? value : string.Empty;
        }

        return row;
    }

    private Dictionary<string, string> CreateValueDictionary(string tableName)
    {
        var dict = new Dictionary<string, string>();

        foreach (var field in GetTableFields(tableName))
        {
            dict[field] = string.Empty;
        }

        return dict;
    }

    private static List<string> GetTableFields(string tableName) => tableName switch
    {
        "customers" => ["CustomerName", "Phone", "Email"],
        "cars" => ["CustomerId", "LicensePlate", "Brand", "Model", "ManufactureYear"],
        "workorders" => ["CarId", "StartDate", "EndDate", "WorkDescription", "WorkStatus"],
        "parts" => ["PartName", "Price"],
        "workorderparts" => ["WorkOrderId", "PartId", "Quantity"],
        _ => []
    };

    private static List<string> GetKeyFields(string tableName) => tableName switch
    {
        "customers" => ["CustomerId"],
        "cars" => ["CarId"],
        "workorders" => ["WorkOrderId"],
        "parts" => ["PartId"],
        "workorderparts" => ["WorkOrderId", "PartId"],
        _ => []
    };

    private static string GetKeyField(string tableName) => GetKeyFields(tableName).FirstOrDefault() ?? string.Empty;

    private bool IsReadOnlyKeyField(string field)
    {
        if (selectedTable == "workorderparts")
            return field is "WorkOrderId" or "PartId";

        return field == GetKeyField(selectedTable);
    }

    private string GetValue(TableRow row, string key)
    {
        return row.Values.TryGetValue(key, out var value) && value != null
            ? value.ToString() ?? string.Empty
            : string.Empty;
    }

    private string GetValue(Dictionary<string, string> dict, string key)
    {
        return dict.TryGetValue(key, out var value) ? value : string.Empty;
    }

    private string TitleText => selectedLanguage == "da"
        ? "Databaseoversigt"
        : "Database overview";

    private string SelectTableText => selectedLanguage == "da"
        ? "Vælg en tabel:"
        : "Select a table:";

    private string ChooseTableText => selectedLanguage == "da"
        ? "vælg en tabel"
        : "choose a table";

    private string LoadingText => selectedLanguage == "da"
        ? "Indlæser tabeller..."
        : "Loading tables...";

    private string NoTablesText => selectedLanguage == "da"
        ? "Ingen tabeller fundet."
        : "No tables found.";

    private string LoadingTableDataText => selectedLanguage == "da"
        ? "Indlæser tabeldata..."
        : "Loading table data...";

    private string NoRowsFoundText => selectedLanguage == "da"
        ? "Ingen rækker fundet."
        : "No rows found.";

    private string EditRowText => selectedLanguage == "da"
        ? "Rediger valgt række"
        : "Edit selected row";

    private string AddRowText => selectedLanguage == "da"
        ? "Tilføj ny række"
        : "Add new row";

    private string AddText => selectedLanguage == "da" ? "Tilføj" : "Add";
    private string UpdateText => selectedLanguage == "da" ? "Opdater" : "Update";
    private string DeleteText => selectedLanguage == "da" ? "Slet" : "Delete";
}